# =============================================================================
# Smart Waste Management System — Backend Environment Variables (.env.example)
# Copy this file to `backend/.env` for local development, or paste into
# Vercel Project Settings -> Environment Variables (Root Directory: `backend`)
# =============================================================================

# 1. Server Runtime
PORT=5001
NODE_ENV=development

# 2. Neon Serverless PostgreSQL (Prisma ORM)
# Pooled connection string (with ?sslmode=require&pgbouncer=true)
DATABASE_URL="postgresql://username:password@ep-example-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
# Direct connection string for Prisma migrations/push
DIRECT_URL="postgresql://username:password@ep-example.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# 3. JWT Authentication Secrets
JWT_ACCESS_SECRET="smart-waste-bilcode-access-secret-key-2026"
JWT_REFRESH_SECRET="smart-waste-bilcode-refresh-secret-key-2026"
JWT_ACCESS_EXPIRES_IN="1d"
JWT_REFRESH_EXPIRES_IN="7d"

# 4. Embedded Machine Learning CNN Model Path
# Local: "../ml/models/tfjs/model.json" | Vercel: "./models/tfjs/model.json"
ML_MODEL_PATH="./models/tfjs/model.json"

# 5. CORS & File Upload Limits
CORS_ORIGIN="*"
MAX_FILE_SIZE_MB=5
UPLOAD_DIR="uploads"
