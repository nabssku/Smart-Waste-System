# Server Configuration
PORT=5000
NODE_ENV=development

# Neon PostgreSQL Connection String
# Format: postgresql://[user]:[password]@[neon_hostname]/[dbname]?sslmode=require
DATABASE_URL="postgresql://user:password@ep-example-123456.ap-southeast-1.aws.neon.tech/smart_waste_db?sslmode=require"

# JWT Secrets
JWT_ACCESS_SECRET="your-super-secret-access-token-key-change-in-production"
JWT_REFRESH_SECRET="your-super-secret-refresh-token-key-change-in-production"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Machine Learning FastAPI Service
ML_API_URL="http://localhost:8000"

# CORS Allowed Origins (comma separated)
CORS_ORIGIN="http://localhost:3000"

# File Upload
MAX_FILE_SIZE_MB=5
UPLOAD_DIR="uploads"
