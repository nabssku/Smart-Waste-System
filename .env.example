# =============================================================================
# Smart Waste Management System — Monorepo Environment Reference (.env.example)
# =============================================================================

# -----------------------------------------------------------------------------
# A. BACKEND (`backend/.env` atau Vercel Project 1 — Root Directory: `backend`)
# -----------------------------------------------------------------------------
PORT=5001
NODE_ENV=production
DATABASE_URL="postgresql://username:password@ep-example-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://username:password@ep-example.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
JWT_ACCESS_SECRET="smart-waste-bilcode-access-secret-key-2026"
JWT_REFRESH_SECRET="smart-waste-bilcode-refresh-secret-key-2026"
JWT_ACCESS_EXPIRES_IN="1d"
JWT_REFRESH_EXPIRES_IN="7d"
ML_MODEL_PATH="./models/tfjs/model.json"
CORS_ORIGIN="*"
MAX_FILE_SIZE_MB=5
UPLOAD_DIR="uploads"

# -----------------------------------------------------------------------------
# B. WEBSITE (`web/.env.local` atau Vercel Project 2 — Root Directory: `web`)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL="https://api-sispel.vercel.app/api"

# -----------------------------------------------------------------------------
# C. MOBILE FLUTTER (`mobile/.env`)
# -----------------------------------------------------------------------------
API_BASE_URL="https://api-sispel.vercel.app/api"
