{
  "info": {
    "_postman_id": "8f7e6d5c-4b3a-4c2d-9e1f-0a1b2c3d4e5f",
    "name": "Smart Waste Management System — API Collection",
    "description": "Koleksi lengkap endpoint REST API & Machine Learning Inference untuk Smart Waste Management System (Auth, ML Predict, Reports CRUD, Admin Users, & Dashboard Statistics).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5001",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "reportId",
      "value": "",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Health & Server Status",
      "item": [
        {
          "name": "Health Check (/health)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Authentication (/api/auth)",
      "item": [
        {
          "name": "Login — Admin (Auto-saves JWT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res && res.data && res.data.accessToken) {",
                  "  pm.collectionVariables.set('accessToken', res.data.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', res.data.refreshToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@smartwaste.id\",\n  \"password\": \"Admin123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Login — User Warga (Auto-saves JWT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res && res.data && res.data.accessToken) {",
                  "  pm.collectionVariables.set('accessToken', res.data.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', res.data.refreshToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@smartwaste.id\",\n  \"password\": \"User123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Register User Baru",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Warga Uji Coba\",\n  \"email\": \"warga.baru@smartwaste.id\",\n  \"password\": \"User123!\",\n  \"phone\": \"08123456789\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "refresh"]
            }
          }
        },
        {
          "name": "Get Current User Profile (/api/auth/me)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Machine Learning Inference (/api/ml/predict)",
      "item": [
        {
          "name": "Predict Waste Image (POST /api/ml/predict)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "image",
                  "type": "file",
                  "src": "ml/dataset/plastic/plastic_001.jpg",
                  "description": "Unggah file foto sampah (.jpg/.png/.webp)"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/ml/predict",
              "host": ["{{baseUrl}}"],
              "path": ["api", "ml", "predict"]
            }
          }
        },
        {
          "name": "Direct Predict Alias (POST /predict)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "image",
                  "type": "file",
                  "src": "ml/dataset/organic/organic_001.jpg"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/predict",
              "host": ["{{baseUrl}}"],
              "path": ["predict"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Waste Reports (/api/reports)",
      "item": [
        {
          "name": "Get All Reports — Admin (Pagination & Filter)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/reports?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reports"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "status", "value": "pending", "disabled": true },
                { "key": "waste_type", "value": "plastic", "disabled": true },
                { "key": "search", "value": "Sudirman", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get My Reports — User",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/reports/my?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reports", "my"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Create New Report (Multipart Form-Data)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res && res.data && res.data.id) {",
                  "  pm.collectionVariables.set('reportId', res.data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "title", "value": "Tumpukan Sampah Plastik di Halte TransJakarta", "type": "text" },
                { "key": "description", "value": "Terdapat kantong plastik dan botol bekas di samping halte.", "type": "text" },
                { "key": "latitude", "value": "-6.2088", "type": "text" },
                { "key": "longitude", "value": "106.8456", "type": "text" },
                { "key": "address", "value": "Jl. Jend. Sudirman, Jakarta Pusat", "type": "text" },
                { "key": "waste_type", "value": "plastic", "type": "text" },
                { "key": "ai_confidence", "value": "0.94", "type": "text" },
                { "key": "image", "type": "file", "src": "ml/dataset/plastic/plastic_001.jpg" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/reports",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reports"]
            }
          }
        },
        {
          "name": "Get Report Detail by ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/reports/{{reportId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reports", "{{reportId}}"]
            }
          }
        },
        {
          "name": "Update Report (Owner / Admin)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Tumpukan Sampah Plastik di Halte (Diperbarui)\",\n  \"description\": \"Volume bertambah menjadi 2 kantong besar di dekat trotoar.\",\n  \"address\": \"Jl. Jend. Sudirman Kav. 21, Jakarta Pusat\",\n  \"waste_type\": \"plastic\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/reports/{{reportId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reports", "{{reportId}}"]
            }
          }
        },
        {
          "name": "Update Report Status — Admin (Creates Audit Log)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"in_progress\",\n  \"admin_notes\": \"Petugas kebersihan wilayah sudah diterjunkan ke titik lokasi.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/reports/{{reportId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reports", "{{reportId}}", "status"]
            }
          }
        },
        {
          "name": "Delete Report",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/reports/{{reportId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reports", "{{reportId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "5. User Management — Admin (/api/users)",
      "item": [
        {
          "name": "List All Users",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Get User by ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "{{userId}}"]
            }
          }
        },
        {
          "name": "Update User Profile / Role",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Warga Pelapor Utama\",\n  \"phone\": \"081298765432\",\n  \"role\": \"user\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "{{userId}}"]
            }
          }
        },
        {
          "name": "Delete User",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "{{userId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "6. Dashboard Statistics (/api/stats)",
      "item": [
        {
          "name": "Get Admin Global Dashboard Stats",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/stats/dashboard",
              "host": ["{{baseUrl}}"],
              "path": ["api", "stats", "dashboard"]
            }
          }
        },
        {
          "name": "Get Personal User Stats (/api/stats/my)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/stats/my",
              "host": ["{{baseUrl}}"],
              "path": ["api", "stats", "my"]
            }
          }
        }
      ]
    }
  ]
}
